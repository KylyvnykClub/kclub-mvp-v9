# Normalise line endings. Without this, a repository shared between Windows and
# Linux stores CRLF, and the shell script inside .github/workflows/docs.yml
# fails on the runner with an unhelpful error.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
