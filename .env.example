# KCLUB v9 — Environment Variables
# Copy to .env.local and fill in values.
# See docs/technology.md for stack rationale.

NODE_ENV=development

# ── Base URLs ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database — PostgreSQL on Neon (via Drizzle) ───────────
# Pooled connection for runtime queries
DATABASE_URL=postgresql://neondb_owner:REPLACE_ME@REPLACE_ME-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct connection for migrations and seeds (drizzle-kit)
DATABASE_URL_DIRECT=postgresql://neondb_owner:REPLACE_ME@REPLACE_ME.REGION.aws.neon.tech/neondb?sslmode=require

# ── Authentication — better-auth (self-hosted) ────────────
# Phone + password for members, email + password + TOTP for staff.
# Session: opaque random id in HttpOnly/Secure/SameSite=Lax cookie.
BETTER_AUTH_SECRET=REPLACE_ME
BETTER_AUTH_URL=http://localhost:3000

# ── Staff auth bootstrap ──────────────────────────────────
ADMIN_BOOTSTRAP_OWNER_PHONE=
ADMIN_BOOTSTRAP_OWNER_PASSWORD=

# AES-256-GCM key for encrypting staff TOTP secrets at rest (base64, 32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=

# ── SMS — Twilio Verify (dev mode: codes logged to console) ─
TWILIO_ACCOUNT_SID=REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_VERIFY_SERVICE_SID=REPLACE_ME

# ── Billing — Stripe ─────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── Background jobs — Inngest ─────────────────────────────
INNGEST_EVENT_KEY=REPLACE_ME
INNGEST_SIGNING_KEY=REPLACE_ME

# ── Rate limiting — Upstash Redis ─────────────────────────
UPSTASH_REDIS_REST_URL=https://REPLACE_ME.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME

# ── Email — Resend ────────────────────────────────────────
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM="KCLUB <hello@kclub.com>"

# ── Object storage — Cloudflare R2 ────────────────────────
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET_NAME=kclub

# ── Bot defense — Cloudflare Turnstile ────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAREPLACE_ME
TURNSTILE_SECRET_KEY=0x4AAAAAAAREPLACE_ME

# ── Observability — Sentry ────────────────────────────────
SENTRY_DSN=https://REPLACE_ME@REPLACE_ME.ingest.sentry.io/REPLACE_ME
NEXT_PUBLIC_SENTRY_DSN=https://REPLACE_ME@REPLACE_ME.ingest.sentry.io/REPLACE_ME

# ── Dev flags (never set in production) ───────────────────
# Log Twilio Verify codes to console instead of sending SMS
AUTH_DEV_PHONE_BYPASS_ENABLED=true
# E2E test seed/teardown routes
# E2E_TEST_SECRET=
