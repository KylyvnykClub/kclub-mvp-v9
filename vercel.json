{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "kylyvnyk.club" }],
      "destination": "https://kylyvnyk.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.kylyvnyk.club" }],
      "destination": "https://kylyvnyk.com/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
