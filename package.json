{
  "name": "kclub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:turbopack": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:normalize-phones": "tsx tools/normalize-phones.ts",
    "db:mark-environment": "tsx tools/db-mark-environment.ts",
    "db:push": "drizzle-kit push",
    "db:reset:dev": "tsx tools/db-reset-dev.ts",
    "db:seed": "tsx tools/seed.ts",
    "db:seed:beta": "tsx tools/seed.ts --beta",
    "db:seed:categories": "tsx --env-file=.env.local tools/seed-categories.ts",
    "db:studio": "drizzle-kit studio",
    "db:updownup": "tsx tools/db-updownup.ts",
    "env:example": "tsx tools/gen-env-example.ts",
    "env:check:production": "tsx tools/check-production-env.ts",
    "smoke:deployment": "tsx tools/smoke-deployment.ts",
    "stripe:check": "tsx tools/check-stripe-delivery.ts",
    "stripe:listen": "tsx tools/stripe-listen.ts",
    "beta:purge": "tsx tools/remove-beta-seed.ts",
    "i18n:check": "tsx tools/check-i18n-keys.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:stripe-lifecycle": "vitest run --config vitest.stripe.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm i18n:check && pnpm test:unit && pnpm verify:build",
    "prepare": "husky",
    "map:generate": "tsx tools/generate-dotted-map.ts && prettier --write \"src/app/[locale]/(dashboard)/dashboard/admin/_components/dotted-world-map.ts\"",
    "verify:build": "tsx tools/verify-build.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@neondatabase/serverless": "^1.1.0",
    "@oslojs/encoding": "^1.1.0",
    "@oslojs/otp": "^1.1.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "^10.69.0",
    "@tailwindcss/postcss": "^4.3.3",
    "arctic": "^3.7.0",
    "argon2": "^0.45.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotted-map": "^3.1.0",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "import-in-the-middle": "^3.3.3",
    "libphonenumber-js": "^1.13.12",
    "lucide-react": "^1.28.0",
    "next": "^15.5.0",
    "next-intl": "^4.13.5",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.25",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "require-in-the-middle": "^8.0.1",
    "resend": "^6.19.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@next/eslint-plugin-next": "^15.5.0",
    "@playwright/test": "^1.62.1",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.7",
    "intl-messageformat": "^11.2.13",
    "lint-staged": "^15.3.0",
    "pg": "^8.22.0",
    "prettier": "^3.6.2",
    "prettier-plugin-compact-markdown-table": "^0.1.0",
    "testcontainers": "^12.0.4",
    "tsx": "^4.23.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "fast-uri": "^3.1.6",
      "nanoid": "^3.3.18",
      "postcss": "^8.5.26",
      "sharp": "^0.35.3"
    },
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "sharp",
      "argon2"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,css,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  }
}
